# =============================================================================
# ARCHITECT-X — Root Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values before starting services.
# Never commit the actual .env file — it is excluded by .gitignore.
# =============================================================================

# ---- PostgreSQL Database -----------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=architect_x
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# ---- Backend API --------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@localhost:5432/architect_x
API_PORT=8000
ENVIRONMENT=development          # development | staging | production

# Allowed CORS origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---- LLM Configuration --------------------------------------------------
# Set LLM_MOCK_MODE=False to enable real OpenAI-compatible API calls.
# In mock mode, the pipeline runs with deterministic pre-set responses.
LLM_MOCK_MODE=True
LLM_API_KEY=                     # Required when LLM_MOCK_MODE=False
LLM_MODEL=gpt-4o-mini            # Model name for real LLM calls
LLM_BASE_URL=                    # Optional: custom base URL (e.g. Azure OpenAI)

# ---- Observability ------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ---- Frontend -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- RAG / Vector Store -------------------------------------------------
# Directory for ChromaDB persistent storage.
# Leave unset to use in-memory fallback (data lost on restart).
CHROMA_PERSIST_DIRECTORY=chroma_db
